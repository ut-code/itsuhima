# 接続先の Postgres (Prisma が参照する)
DATABASE_URL=postgresql://postgres:password@localhost:5432/itsuhima_dev
# 待ち受けポート。省略時は 3000
PORT=3000
# CORS で許可するオリジン。カンマ区切り
CORS_ALLOW_ORIGINS=http://localhost:5173
# browserId の Cookie を送るドメイン。省略時は localhost
DOMAIN=localhost
NODE_ENV=dev # dev or production
# browserId の Cookie の署名鍵。必須
COOKIE_SECRET=your-random-secret-key-for-development
# 鍵のローテーション時だけ、前の COOKIE_SECRET をカンマ区切りで指定する。省略可
# COOKIE_SECRET_PREVIOUS=
