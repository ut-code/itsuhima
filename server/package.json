{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "cd ../client && npm run build && cd ../server && wrangler deploy --dry-run --outdir dist",
    "deploy": "cd ../client && npm run build && cd ../server && wrangler deploy",
    "deploy:staging": "cd ../client && npm run build:staging && cd ../server && wrangler deploy --env staging",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@cloudflare/pages-plugin-vercel-og": "^0.1.2",
    "@hono/zod-validator": "^0.7.2",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.9.6",
    "nanoid": "^5.1.5",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
