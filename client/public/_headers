# Worker の静的アセットに付けるヘッダ。Worker が返すレスポンス (/e/*、/og/*、/api/* など) には付かない
# noindex のうち、Worker が返すレスポンスの分は server/src/middleware/noindex.ts で付ける (ここは静的アセットの分だけ)

# ステージングは検索に載せない
https://itsuhima-staging.utcode.net/*
  X-Robots-Tag: noindex

# 同意画面・ログイン画面・アカウントのページは、他のサイトの iframe に入れさせない (クリックジャッキング対策)
/oauth/consent
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

/login
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

/account
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
